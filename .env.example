# =============================================================================
# Chatify AI - Environment Variables Template
# =============================================================================
# 
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env for Docker/Production deployments
#   2. For local development, use User Secrets instead (see setup-secrets.ps1)
#   3. Fill in your actual values (NEVER commit .env to git)
#   4. Restart the application after making changes
#
# PRIORITY: Environment variables override appsettings.json values
# =============================================================================

# =============================================================================
# 🔐 REQUIRED SECRETS - Must be configured
# =============================================================================

# -----------------------------------------------------------------------------
# Database Connection String
# -----------------------------------------------------------------------------
# Where: SQL Server database for storing users, sessions, feedback, etc.
# Format: Server=<host>;Database=<name>;User Id=<user>;Password=<pass>;TrustServerCertificate=True;
# 
# Local Development (Windows Auth):
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost;Database=ChatifyAI_Dev;Integrated Security=true;TrustServerCertificate=True;
# 
# Docker/Production (SQL Auth):
# CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=sqlserver;Database=ChatifyAI;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;
#
# Azure SQL:
# CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=tcp:yourserver.database.windows.net,1433;Database=ChatifyAI;User Id=youradmin;Password=YourPassword123;Encrypt=True;

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration
# -----------------------------------------------------------------------------
# Where: Azure Portal → Your Azure OpenAI Resource → Keys and Endpoint
# Endpoint format: https://<your-resource-name>.openai.azure.com/
#
AZUREOPENAI__ENDPOINT=https://your-resource.openai.azure.com/
AZUREOPENAI__APIKEY=your-azure-openai-api-key-here

# Optional: Override deployment names if different from defaults
# AZUREOPENAI__CHATDEPLOYMENTNAME=gpt-4o
# AZUREOPENAI__EMBEDDINGDEPLOYMENTNAME=text-embedding-3-small
# AZUREOPENAI__MAXTOKEN=1000
# AZUREOPENAI__TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# JWT Secret for Authentication
# -----------------------------------------------------------------------------
# Generate a secure random key (minimum 32 characters):
#   PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | % {[char]$_})
#   OpenSSL: openssl rand -base64 64
#
JWT__SECRET=

# -----------------------------------------------------------------------------
# Admin User Credentials (First-time Setup)
# -----------------------------------------------------------------------------
# These are used to create the default admin user on first run
# You can change these via the admin panel after first login
#
ADMIN__USERNAME=admin
ADMIN__PASSWORD=Admin@123456

# =============================================================================
# 📧 EMAIL CONFIGURATION (Optional - for EmailPlugin)
# =============================================================================
# Required only if you want to enable email sending functionality
# Set Email:Enabled in appsettings.{Environment}.json, not here
#
# EMAIL__SMTPHOST=smtp.gmail.com
# EMAIL__SMTPPORT=587
# EMAIL__ENABLESSL=true
# EMAIL__USERNAME=your-email@gmail.com
# EMAIL__PASSWORD=your-app-password-here
# EMAIL__FROMEMAIL=notifications@yourcompany.com
# EMAIL__FROMNAME=Chatify AI
# EMAIL__ADMINEMAIL=admin@yourcompany.com
# EMAIL__TIMEOUTSECONDS=30
#
# Gmail Setup:
#   1. Enable 2FA: https://myaccount.google.com/security
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password (remove spaces)
#
# Other Providers:
#   Outlook: smtp-mail.outlook.com:587
#   SendGrid: smtp.sendgrid.net:587
#   Mailgun: smtp.mailgun.org:587

# =============================================================================
# 🔑 API KEYS (Production Only - for API Key Authentication)
# =============================================================================
# For production deployments only. Use these for programmatic API access.
# Generate secure keys: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# For development, test via admin panel instead.
#
# APIKEYS__ADMIN=your-secure-admin-key-here
# APIKEYS__CLIENT1=your-secure-client-key-here
# APIKEYS__CLIENT2=your-secure-client-key-here

# =============================================================================
# 🌐 ENVIRONMENT-SPECIFIC OVERRIDES (Optional)
# =============================================================================

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
# Default: http://localhost:6333 (from appsettings.json)
# 
# Docker Compose:
# QDRANT__ENDPOINT=http://qdrant:6333
#
# Qdrant Cloud:
# QDRANT__ENDPOINT=https://your-cluster.cloud.qdrant.io
# QDRANT__APIKEY=your-qdrant-cloud-api-key
#
# QDRANT__COLLECTIONNAME=knowledge-base-prod

# -----------------------------------------------------------------------------
# Application Behavior Overrides
# -----------------------------------------------------------------------------
# These have sensible defaults in appsettings.json
# Override only if you need environment-specific values
#
# CHAT__MAXCONVERSATIONHISTORY=20
# CHAT__MAXTOOLCALLS=5
# CHAT__MAXMESSAGELENGTH=10000
# CHAT__SEARCHSCORETHRESHOLD=0.7
# CHAT__RAGTOPK=3
#
# CACHE__ENABLED=true
# CACHE__CONVERSATIONEXPIRATIONMINUTES=60
# CACHE__EMBEDDINGEXPIRATIONHOURS=24
#
# RESILIENCE__ENABLED=true
# RESILIENCE__RETRYCOUNT=3
# RESILIENCE__TIMEOUTSECONDS=30

# =============================================================================
# 🐳 DOCKER-SPECIFIC VARIABLES
# =============================================================================
# Only used by docker-compose.yml
#
SQL_SA_PASSWORD=YourStrong@Password123
ASPNETCORE_ENVIRONMENT=Production
