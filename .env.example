# Example environment variables for Docker deployment
# Copy this file to .env and fill in your actual values

# Database Configuration
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=sqlserver;Database=ChatifyAI;User Id=sa;Password=YourStrongPassword123;TrustServerCertificate=True;

# Azure OpenAI Configuration
AZUREOPENAI__ENDPOINT=https://your-resource.openai.azure.com/
AZUREOPENAI__APIKEY=your-azure-openai-api-key-here
AZUREOPENAI__CHATDEPLOYMENTNAME=gpt-4o
AZUREOPENAI__EMBEDDINGDEPLOYMENTNAME=text-embedding-3-small

# API Keys for Authentication
APIKEYS__DEMO-USER=demo-key-12345
APIKEYS__TEST-USER=test-key-67890
APIKEYS__ADMIN-USER=admin-key-abcdef

# Qdrant Vector Database Configuration
QDRANT__ENDPOINT=http://qdrant:6333
QDRANT__COLLECTIONNAME=chatai_knowledge
QDRANT__VECTORSIZE=1536
