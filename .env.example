# Chatify AI - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQL Server connection string
# Format: Server=<host>;Database=<name>;User Id=<user>;Password=<pass>;TrustServerCertificate=True;
# 
# Development (local):
#   CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost;Database=ChatifyAI_Dev;Integrated Security=true;TrustServerCertificate=True;
# 
# Production (Docker/Azure):
#   CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=sqlserver;Database=ChatifyAI;User Id=sa;Password=YourStrongPassword123;TrustServerCertificate=True;
#
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost;Database=ChatifyAI_Dev;Integrated Security=true;TrustServerCertificate=True;

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================
# Get these from Azure Portal → Your Azure OpenAI Resource
# Endpoint format: https://<your-resource-name>.openai.azure.com/
AZUREOPENAI__ENDPOINT=https://your-resource.openai.azure.com/
AZUREOPENAI__APIKEY=your-azure-openai-api-key-here

# Deployment names (must match your Azure deployments)
AZUREOPENAI__CHATDEPLOYMENTNAME=gpt-4o
AZUREOPENAI__EMBEDDINGDEPLOYMENTNAME=text-embedding-3-small

# =============================================================================
# EMAIL/SMTP CONFIGURATION (for EmailPlugin)
# =============================================================================
# Gmail Setup:
#   1. Enable 2FA on your Google account
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password (no spaces)
#
# For other providers (Outlook, SendGrid, etc.), adjust SmtpHost and SmtpPort

EMAIL__SMTPHOST=smtp.gmail.com
EMAIL__SMTPPORT=587
EMAIL__ENABLESSL=true
EMAIL__USERNAME=your-email@gmail.com
EMAIL__PASSWORD=your-app-password-here
EMAIL__FROMEMAIL=notifications@yourcompany.com
EMAIL__FROMNAME=Chatify AI
EMAIL__TIMEOUTSECONDS=30

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
# Development (local Qdrant):
#   QDRANT__ENDPOINT=http://localhost:6333
# 
# Production (Docker Compose):
#   QDRANT__ENDPOINT=http://qdrant:6333
#
# Cloud (Qdrant Cloud):
#   QDRANT__ENDPOINT=https://your-cluster.cloud.qdrant.io
#   QDRANT__APIKEY=your-qdrant-api-key
#
QDRANT__ENDPOINT=http://localhost:6333
QDRANT__COLLECTIONNAME=chatai_knowledge
QDRANT__VECTORSIZE=1536

# =============================================================================
# API KEYS FOR AUTHENTICATION (Optional)
# =============================================================================
# Generate secure random keys:
#   openssl rand -base64 32
#   or
#   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
#
# Leave empty to disable API key authentication
APIKEYS__ADMIN-USER=
APIKEYS__DEMO-USER=
APIKEYS__TEST-USER=

# =============================================================================
# OPTIONAL: OVERRIDE APPLICATION SETTINGS
# =============================================================================
# You can override any appsettings.json value using environment variables
# Format: SECTION__SUBSECTION__KEY=value
#
# Examples:
# CHAT__MAXCONVERSATIONHISTORY=30
# RESILIENCE__RETRYCOUNT=5
# CACHE__ENABLED=false
# SERILOG__MINIMUMLEVEL__DEFAULT=Debug
