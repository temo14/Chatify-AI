# ⚠️ DO NOT COMMIT THIS FILE TO GIT ⚠️
# This file is for reference only. ASP.NET Core does not load .env files by default.
# Use appsettings.Development.json for local development secrets.
# Use environment variables for production secrets.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Local development (Windows Authentication)
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost;Database=ChatifyAI_Dev;Integrated Security=true;TrustServerCertificate=True;

# Docker deployment (SQL Server with password)
# CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=sqlserver;Database=ChatifyAI;User Id=sa;Password=YourStrongPassword123;TrustServerCertificate=True;

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================
# AZUREOPENAI__ENDPOINT=https://your-endpoint.openai.azure.com/
# AZUREOPENAI__APIKEY=your-api-key-here
AZUREOPENAI__CHATDEPLOYMENTNAME=gpt-4o
AZUREOPENAI__EMBEDDINGDEPLOYMENTNAME=text-embedding-3-small

# =============================================================================
# EMAIL/SMTP CONFIGURATION
# =============================================================================
# Gmail example (requires App Password - see .env.example for setup)
# EMAIL__SMTPHOST=smtp.gmail.com
# EMAIL__SMTPPORT=587
# EMAIL__ENABLESSL=true
# EMAIL__USERNAME=your-email@gmail.com
# EMAIL__PASSWORD=your-app-password
# EMAIL__FROMEMAIL=your-email@gmail.com
EMAIL__FROMNAME=Chatify AI

# Optional: Override appsettings to enable email in development
# EMAIL__ENABLED=true

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
# Local development
QDRANT__ENDPOINT=http://localhost:6333

# Docker deployment
# QDRANT__ENDPOINT=http://qdrant:6333

QDRANT__COLLECTIONNAME=knowledge-base-dev
QDRANT__VECTORSIZE=1536

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# JWT secrets are in appsettings.Development.json for local dev
# For production, set as environment variables: JWT__SECRET, etc.

# =============================================================================
# DEFAULT ADMIN USER
# =============================================================================
# These credentials will be used to create the default admin user on first startup
ADMIN__USERNAME=admin
ADMIN__PASSWORD=Admin@123456
# - AZURE_OPENAI_* legacy format (use AZUREOPENAI__ instead)
