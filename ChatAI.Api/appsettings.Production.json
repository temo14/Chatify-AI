{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "ChatAI": "Information"
    }
  },

  "KeyVault": {
    "Endpoint": "https://chatify-kv-4021.vault.azure.net/"
  },

  "Qdrant": {
    "Endpoint": "DISABLED",
    "CollectionName": "DISABLED"
  },

  "IpRateLimiting": {
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/chat",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "*/chat",
        "Period": "1h",
        "Limit": 200
      }
    ]
  }
}
