{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "ChatAI": "Information"
    }
  },

  "Qdrant": {
    "Endpoint": "http://qdrant:6333",
    "CollectionName": "knowledge-base-prod"
  },

  "IpRateLimiting": {
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*/chat",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "*/chat",
        "Period": "1h",
        "Limit": 200
      }
    ]
  }
}
