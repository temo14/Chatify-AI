{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "ChatAI": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "ChatDeploymentName": "gpt-4o",
    "EmbeddingDeploymentName": "text-embedding-3-small"
  },
  
  "Chat": {
    "MaxConversationHistory": 10,
    "MaxMessageLength": 10000,
    "SearchScoreThreshold": 0.7,
    "RagTopK": 3
  },

  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "CollectionName": "knowledge-base-dev",
    "VectorSize": 1536
  },

  "Resilience": {
    "Enabled": true,
    "RetryCount": 2,
    "RetryDelayMs": 500,
    "CircuitBreakerThreshold": 3,
    "CircuitBreakerDurationSeconds": 15,
    "TimeoutSeconds": 20
  },

  "Cache": {
    "Enabled": true,
    "DefaultExpirationMinutes": 5,
    "ConversationExpirationMinutes": 10,
    "EmbeddingExpirationHours": 1
  },

  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "FromEmail": "",
    "FromName": "Chatify AI",
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "TimeoutSeconds": 30
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "GeneralRules": []
  }
}
