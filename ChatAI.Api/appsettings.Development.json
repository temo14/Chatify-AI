{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "ChatAI": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ChatifyAI_Dev;Integrated Security=true;TrustServerCertificate=True;"
  },

  "AzureOpenAI": {
    "Endpoint": "https://your-dev-resource.openai.azure.com/",
    "ApiKey": "your-dev-api-key-here",
    "ChatDeploymentName": "gpt-4o",
    "EmbeddingDeploymentName": "text-embedding-3-small",
    "MaxTokens": 800,
    "Temperature": 0.7
  },
  
  "Chat": {
    "MaxToolCalls": 5,
    "MaxConversationHistory": 10,
    "DefaultSystemPrompt": "You are a helpful AI assistant. [DEVELOPMENT ENVIRONMENT]"
  },

  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "CollectionName": "knowledge-base-dev",
    "VectorSize": 1536
  },

  "Resilience": {
    "Enabled": true,
    "RetryCount": 2,
    "RetryDelayMs": 500,
    "CircuitBreakerThreshold": 3,
    "CircuitBreakerDurationSeconds": 15,
    "TimeoutSeconds": 20
  },

  "Cache": {
    "Enabled": true,
    "DefaultExpirationMinutes": 5,
    "ConversationExpirationMinutes": 10,
    "EmbeddingExpirationHours": 1,
    "ToolResultExpirationMinutes": 5,
    "MaxCachedItems": 1000
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "GeneralRules": []
  },

  "ApiKeys": {
    "dev-user": "dev-test-key-12345",
    "dev-admin": "dev-admin-key-67890"
  }
}
