{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "ChatAI": "Information"
    }
  },

  "Qdrant": {
    "CollectionName": "knowledge-base-staging"
  },

  "Cache": {
    "DefaultExpirationMinutes": 15,
    "ConversationExpirationMinutes": 30,
    "EmbeddingExpirationHours": 12,
    "ToolResultExpirationMinutes": 10,
    "MaxCachedItems": 5000
  },

  "IpRateLimiting": {
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*/chat",
        "Period": "1m",
        "Limit": 30
      }
    ]
  }
}
