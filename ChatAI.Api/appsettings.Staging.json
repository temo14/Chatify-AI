{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information",
      "ChatAI": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ChatifyAI_Staging;Integrated Security=true;TrustServerCertificate=True;"
  },

  "AzureOpenAI": {
    "Endpoint": "https://your-staging-resource.openai.azure.com/",
    "ApiKey": "",
    "ChatDeploymentName": "gpt-4o",
    "EmbeddingDeploymentName": "text-embedding-3-small",
    "MaxTokens": 1000,
    "Temperature": 0.7
  },
  
  "Chat": {
    "MaxToolCalls": 5,
    "MaxConversationHistory": 20,
    "DefaultSystemPrompt": "You are a helpful AI assistant with access to various tools and a knowledge base. [STAGING ENVIRONMENT]"
  },

  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "CollectionName": "knowledge-base-staging",
    "VectorSize": 1536
  },

  "Resilience": {
    "Enabled": true,
    "RetryCount": 3,
    "RetryDelayMs": 1000,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "TimeoutSeconds": 30
  },

  "Cache": {
    "Enabled": true,
    "DefaultExpirationMinutes": 15,
    "ConversationExpirationMinutes": 30,
    "EmbeddingExpirationHours": 12,
    "ToolResultExpirationMinutes": 10,
    "MaxCachedItems": 5000
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*/chat",
        "Period": "1m",
        "Limit": 30
      }
    ]
  },

  "ApiKeys": {
    "staging-user": "staging-test-key-123",
    "staging-admin": "staging-admin-key-456"
  }
}
