<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2a0435ac-8b19-49e2-b112-49bbbdde52d1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
