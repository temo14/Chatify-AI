{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.AspNetCore.Authorization": "Information",
      "ChatAI": "Debug"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "ChatDeploymentName": "gpt-4o",
    "EmbeddingDeploymentName": "text-embedding-3-small",
    "MaxTokens": 1000,
    "Temperature": 0.7
  },
  
  "Chat": {
    "MaxToolCalls": 5,
    "MaxConversationHistory": 20,
    "MaxMessageLength": 10000,
    "SearchScoreThreshold": 0.3,
    "RagTopK": 3
  },

  "Qdrant": {
    "Endpoint": "http://localhost:6333",
    "CollectionName": "knowledge-base",
    "VectorSize": 1536
  },

  "Resilience": {
    "Enabled": true,
    "RetryCount": 3,
    "RetryDelayMs": 1000,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "TimeoutSeconds": 30
  },

  "Cache": {
    "Enabled": true,
    "DefaultExpirationMinutes": 30,
    "ConversationExpirationMinutes": 60,
    "EmbeddingExpirationHours": 24,
    "ToolResultExpirationMinutes": 15,
    "MaxCachedItems": 10000
  },

  "Email": {
    "Enabled": true,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromEmail": "",
    "FromName": "Chatify AI",
    "Username": "",
    "Password": "",
    "AdminEmail": "",
    "EnableSsl": true,
    "TimeoutSeconds": 30
  },

  "Jwt": {
    "Secret": "",
    "Issuer": "ChatifyAI",
    "Audience": "ChatifyAI",
    "ExpirationMinutes": 60,
    "RememberMeExpirationMinutes": 10080
  },

  "ApiKeys": {},

  "Admin": {
    "Username": "",
    "Password": ""
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*/chat",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "*/chat",
        "Period": "1h",
        "Limit": 100
      }
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "ChatAI": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/chatai-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithEnvironmentName"]
  },

  "HealthChecks": {
    "Enabled": true,
    "Endpoints": {
      "Health": "/health",
      "Ready": "/health/ready"
    }
  }
}
